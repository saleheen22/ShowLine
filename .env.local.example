# Copy to .env.local and fill in. .env.local is gitignored.
OPENROUTER_API_KEY=sk-or-v1-...
# OpenRouter model slug. Defaults to anthropic/claude-opus-4 if unset.
OPENROUTER_MODEL=anthropic/claude-opus-4
# Optional: human-readable label sent in the HTTP-Referer / X-Title headers for OpenRouter analytics.
OPENROUTER_APP_NAME=Showline
